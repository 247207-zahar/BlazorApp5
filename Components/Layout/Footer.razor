@using BlazorApp5.Services

<style>
    .footer {
        background: #1a1a1a;
        color: #aaa;
        padding: 3rem 2rem 2rem;
        font-family: 'DM Sans', sans-serif;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 2rem;
        max-width: 1100px;
        margin: 0 auto 2rem;
    }

    @@media(max-width: 600px) {
        .footer-grid {
            grid-template-columns: 1fr;
        }
    }

    .footer-brand h3 {
        font-family: 'Sora', sans-serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: #d4380d;
        margin-bottom: 0.75rem;
    }

    .footer-brand p {
        font-size: 0.85rem;
        line-height: 1.6;
        max-width: 280px;
    }
