@page "/dashboard"
@rendermode InteractiveServer
@using BlazorApp5.Models
@using BlazorApp5.Services
@inject OrderService OrderService
@inject NavigationManager Navigation

<PageTitle>My Dashboard - FoodPanda</PageTitle>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .dash-root {
        font-family: 'DM Sans', sans-serif;
        background: #fef6f0;
        min-height: 100vh;
        color: #1a1a1a;
    }

    .dash-layout {
        display: grid;
        grid-template-columns: 240px 1fr;
        min-height: 100vh;
    }

    @@media (max-width: 768px) {
        .dash-layout {
            grid-template-columns: 1fr;
        }

        .dash-sidebar {
            display: none;
        }
    }

    .dash-sidebar {
        background: #fff;
        border-right: 1px solid #f0ece8;
        padding: 2rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .sidebar-logo {
        font-family: 'Sora', sans-serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: #d4380d;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sidebar-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.75rem;
        background: #fff5f0;
        border-radius: 14px;
        margin-bottom: 1.5rem;
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d4380d, #fa8c16);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-family: 'Sora', sans-serif;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .profile-name {
        font-weight: 600;
        font-size: 0.9rem;
        color: #1a1a1a;
    }

    .profile-email {
        font-size: 0.75rem;
        color: #999;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.7rem 1rem;
        border-radius: 12px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        color: #666;
        transition: all 0.2s;
        border: none;
        background: none;
        width: 100%;
        text-align: left;
        text-decoration: none;
    }

        .nav-item:hover {
            background: #fff5f0;
            color: #d4380d;
        }

        .nav-item.active {
            background: #d4380d;
            color: #fff;
        }

        .nav-item .nav-icon {
            font-size: 1rem;
            width: 20px;
        }
</style>