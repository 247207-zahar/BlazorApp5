@page "/dashboard"
@rendermode InteractiveServer
@using BlazorApp5.Models
@using BlazorApp5.Services
@inject OrderService OrderService
@inject NavigationManager Navigation

<PageTitle>My Dashboard - FoodPanda</PageTitle>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .dash-root {
        font-family: 'DM Sans', sans-serif;
        background: #fef6f0;
        min-height: 100vh;
        color: #1a1a1a;
    }

    .dash-layout {
        display: grid;
        grid-template-columns: 240px 1fr;
        min-height: 100vh;
    }

    @@media (max-width: 768px) {
        .dash-layout {
            grid-template-columns: 1fr;
        }

        .dash-sidebar {
            display: none;
        }
    }

    .dash-sidebar {
        background: #fff;
        border-right: 1px solid #f0ece8;
        padding: 2rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .sidebar-logo {
        font-family: 'Sora', sans-serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: #d4380d;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sidebar-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.75rem;
        background: #fff5f0;
        border-radius: 14px;
        margin-bottom: 1.5rem;
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d4380d, #fa8c16);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-family: 'Sora', sans-serif;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .profile-name {
        font-weight: 600;
        font-size: 0.9rem;
        color: #1a1a1a;
    }

    .profile-email {
        font-size: 0.75rem;
        color: #999;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.7rem 1rem;
        border-radius: 12px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        color: #666;
        transition: all 0.2s;
        border: none;
        background: none;
        width: 100%;
        text-align: left;
        text-decoration: none;
    }

        .nav-item:hover {
            background: #fff5f0;
            color: #d4380d;
        }

        .nav-item.active {
            background: #d4380d;
            color: #fff;
        }

        .nav-item .nav-icon {
            font-size: 1rem;
            width: 20px;
        }

    .nav-section-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #bbb;
        padding: 0.5rem 1rem 0.25rem;
        font-weight: 500;
    }

    .dash-main {
        padding: 2rem;
        overflow-y: auto;
    }

    .dash-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

        .dash-topbar h1 {
            font-family: 'Sora', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a1a;
        }

        .dash-topbar .greeting {
            font-size: 0.85rem;
            color: #999;
            margin-top: 2px;
        }

    .order-btn {
        padding: 0.65rem 1.25rem;
        background: #d4380d;
        color: #fff;
        border: none;
        border-radius: 50px;
        font-family: 'DM Sans', sans-serif;
        font-weight: 500;
        cursor: pointer;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.2s;
    }

        .order-btn:hover {
            background: #b83209;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: #fff;
        border-radius: 16px;
        padding: 1.25rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }

    .stat-label {
        font-size: 0.78rem;
        color: #999;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .stat-value {
        font-family: 'Sora', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-top: 4px;
    }

    .stat-sub {
        font-size: 0.78rem;
        color: #389e0d;
        margin-top: 4px;
    }

    .section-card {
        background: #fff;
        border-radius: 18px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        margin-bottom: 1.5rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
    }

        .section-header h2 {
            font-family: 'Sora', sans-serif;
            font-size: 1rem;
            font-weight: 600;
            color: #1a1a1a;
        }

    .filter-tabs {
        display: flex;
        gap: 0.5rem;
    }

    .filter-tab {
        padding: 0.35rem 0.85rem;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        border: 1.5px solid #e8e8e8;
        background: none;
        color: #666;
        transition: all 0.2s;
    }

        .filter-tab.active {
            background: #d4380d;
            color: #fff;
            border-color: #d4380d;
        }

        .filter-tab:hover:not(.active) {
            border-color: #d4380d;
            color: #d4380d;
        }

    .order-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #f5f5f5;
        transition: background 0.15s;
    }

        .order-row:last-child {
            border-bottom: none;
        }

    .order-restaurant-img {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: linear-gradient(135deg, #ffe0cc, #ffa07a);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .order-info {
        flex: 1;
    }

    .order-name {
        font-weight: 600;
        font-size: 0.92rem;
        color: #1a1a1a;
    }

    .order-items {
        font-size: 0.8rem;
        color: #999;
        margin-top: 2px;
    }

    .order-date {
        font-size: 0.75rem;
        color: #bbb;
        margin-top: 2px;
    }

    .order-amount {
        font-weight: 600;
        font-size: 0.92rem;
        color: #1a1a1a;
        min-width: 80px;
        text-align: right;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        min-width: 80px;
        justify-content: center;
    }

    .status-placed {
        background: #e6f7ff;
        color: #096dd9;
    }

    .status-preparing {
        background: #fff7e6;
        color: #d46b08;
    }

    .status-on-the-way {
        background: #f0f5ff;
        color: #2f54eb;
    }

    .status-delivered {
        background: #f6ffed;
        color: #389e0d;
    }

    .status-cancelled {
        background: #fff1f0;
        color: #cf1322;
    }


    .order-actions {
        display: flex;
        gap: 0.5rem;
    }

    .action-btn {
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 500;
        cursor: pointer;
        border: 1.5px solid #e8e8e8;
        background: #fafafa;
        color: #555;
        transition: all 0.15s;
        text-decoration: none;
    }

        .action-btn:hover {
            border-color: #d4380d;
            color: #d4380d;
            background: #fff5f0;
        }

        .action-btn.primary {
            background: #d4380d;
            color: #fff;
            border-color: #d4380d;
        }

            .action-btn.primary:hover {
                background: #b83209;
            }

    .fav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 1rem;
    }

    .fav-card {
        background: #fafafa;
        border: 1.5px solid #f0f0f0;
        border-radius: 14px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
        text-decoration: none;
    }

        .fav-card:hover {
            border-color: #d4380d;
            transform: translateY(-2px);
            background: #fff5f0;
        }

        .fav-card .fav-emoji {
            font-size: 1.8rem;
            display: block;
            margin-bottom: 0.5rem;
        }

        .fav-card .fav-name {
            font-weight: 600;
            font-size: 0.85rem;
            color: #1a1a1a;
        }

        .fav-card .fav-cuisine {
            font-size: 0.75rem;
            color: #999;
            margin-top: 2px;
        }

        .fav-card .fav-rating {
            font-size: 0.75rem;
            color: #fa8c16;
            margin-top: 4px;
        }

    .address-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
    }

    .address-card {
        border: 1.5px solid #f0f0f0;
        border-radius: 14px;
        padding: 1rem;
        background: #fafafa;
        position: relative;
    }

        .address-card.default {
            border-color: #d4380d;
            background: #fff5f0;
        }

    .address-type {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        color: #d4380d;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .address-text {
        font-size: 0.85rem;
        color: #444;
        line-height: 1.5;
    }

    .default-badge {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        background: #d4380d;
        color: #fff;
        font-size: 0.68rem;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 50px;
    }

    .add-new-card {
        border: 1.5px dashed #e8e8e8;
        border-radius: 14px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #bbb;
        font-size: 0.85rem;
        gap: 4px;
        transition: all 0.2s;
        background: none;
        min-height: 90px;
    }

        .add-new-card:hover {
            border-color: #d4380d;
            color: #d4380d;
        }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #ccc;
    }
   
</style>

<div class="dash-root">
    <div class="dash-layout">
           <aside class="dash-sidebar">
            <div class="sidebar-logo">🐼 FoodPanda</div>

            <div class="sidebar-profile">
                <div class="avatar">@GetInitials(customer?.Name ?? "A")</div>
                <div>
                    <div class="profile-name">@(customer?.Name ?? " Ali")</div>
                    <div class="profile-email">@(customer?.Email ?? "Ali@email.com")</div>
                </div>
            </div>
            <span class="nav-section-label">Main</span>
            <button class="nav-item @(activeTab == "orders" ? "active" : "")" @onclick='() => activeTab = "orders"'>
                <span class="nav-icon">📦</span> My Orders
            </button>
            <button class="nav-item @(activeTab == "favorites" ? "active" : "")" @onclick='() => activeTab = "favorites"'>
                <span class="nav-icon">❤️</span> Favorites
            </button>
            <button class="nav-item @(activeTab == "addresses" ? "active" : "")" @onclick='() => activeTab = "addresses"'>
                <span class="nav-icon">📍</span> Addresses
            </button>

            <span class="nav-section-label" style="margin-top:1rem;">Account</span>
            <button class="nav-item @(activeTab == "profile" ? "active" : "")" @onclick='() => activeTab = "profile"'>
                <span class="nav-icon">👤</span> Profile Settings
            </button>
            <a href="/track-order" class="nav-item">
                <span class="nav-icon">🛵</span> Track Active Order
            </a>
            <button class="nav-item" style="color:#cf1322;" @onclick="Logout">
                <span class="nav-icon">🚪</span> Logout
            </button>


           </aside>

           <main class="dash-main">
            <div class="dash-topbar">
                <div>
                    <h1>@GetGreeting(), @(customer?.Name?.Split(' ')[0] ?? "Zahra")! 👋</h1>
                    <div class="greeting">@DateTime.Now.ToString("dddd, MMMM dd")</div>
                </div>
                <a href="/restaurants" class="order-btn">+ Order Food</a>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Total Orders</div>
                    <div class="stat-value">@orders.Count</div>
                    <div class="stat-sub">↑ 3 this month</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Amount Spent</div>
                    <div class="stat-value">Rs. @orders.Sum(o => o.TotalAmount).ToString("N0")</div>
                    <div class="stat-sub">lifetime total</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Delivered</div>
                    <div class="stat-value">@orders.Count(o => o.Status == "Delivered")</div>
                    <div class="stat-sub" style="color:#389e0d;">✓ on time</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Saved (Promos)</div>
                    <div class="stat-value">Rs. 840</div>
                    <div class="stat-sub" style="color:#fa8c16;">🎉 great deals</div>
                </div>
            </div>

            @if (activeTab == "orders")
            {
                <div class="section-card">
                    <div class="section-header">
                        <h2>My Orders</h2>
                        <div class="filter-tabs">
                            <button class="filter-tab @(orderFilter == "all" ? "active" : "")" @onclick='() => orderFilter = "all"'>All</button>
                            <button class="filter-tab @(orderFilter == "active" ? "active" : "")" @onclick='() => orderFilter = "active"'>Active</button>
                            <button class="filter-tab @(orderFilter == "delivered" ? "active" : "")" @onclick='() => orderFilter = "delivered"'>Delivered</button>
                        </div>
                    </div>

                    @foreach (var order in FilteredOrders)
                    {
                        <div class="order-row">
                            <div class="order-restaurant-img">@order.RestaurantEmoji</div>
                            <div class="order-info">
                                <div class="order-name">@order.RestaurantName</div>
                                <div class="order-items">@order.ItemsSummary</div>
                                <div class="order-date">@order.PlacedAt.ToString("MMM dd, yyyy · hh:mm tt")</div>
                            </div>
                            <div>
                                <span class="status-badge status-@order.Status.ToLower().Replace(" ", "-")">
                                    @GetStatusIcon(order.Status) @order.Status
                                </span>
                            </div>
                            <div class="order-amount">Rs. @order.TotalAmount.ToString("N0")</div>
                            <div class="order-actions">
                                @if (order.Status == "Delivered")
                                {
                                    <a href="/restaurants" class="action-btn primary">Reorder</a>
                                }
                                @if (order.Status != "Delivered" && order.Status != "Cancelled")
                                {
                                    <a href="/track-order" class="action-btn primary">Track</a>
                                }
                                <button class="action-btn" @onclick="() => ShowDetails(order)">Details</button>
                            </div>
                        </div>
                    }

                    @if (!FilteredOrders.Any())
                    {
                        <div class="empty-state">
                            <div style="font-size:2.5rem;margin-bottom:0.5rem;">📭</div>
                            <div>No orders found</div>
                        </div>
                    }
                </div>
            }

            @if (activeTab == "favorites")
            {
                <div class="section-card">
                    <div class="section-header">
                        <h2>Favorite Restaurants</h2>
                    </div>
                    <div class="fav-grid">
                        @foreach (var fav in favorites)
                        {
                            <a href="/menu/@fav.Id" class="fav-card">
                                <span class="fav-emoji">@fav.Emoji</span>
                                <div class="fav-name">@fav.Name</div>
                                <div class="fav-cuisine">@fav.Cuisine</div>
                                <div class="fav-rating">★ @fav.Rating</div>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (activeTab == "addresses")
            {
                <div class="section-card">
                    <div class="section-header">
                        <h2>Saved Addresses</h2>
                    </div>
                    <div class="address-grid">
                        @foreach (var addr in addresses)
                        {
                            <div class="address-card @(addr.IsDefault ? "default" : "")">
                                @if (addr.IsDefault)
                                {
                                    <span class="default-badge">Default</span>
                                }
                                <div class="address-type">@addr.Type</div>
                                <div class="address-text">@addr.FullAddress</div>
                            </div>
                        }
                        <button class="add-new-card" @onclick="AddAddress">
                            <span style="font-size:1.5rem;">+</span>
                            <span>Add Address</span>
                        </button>
                    </div>
                </div>
            }


            @if (activeTab == "profile")
            {
                <div class="section-card" style="max-width:550px;">
                    <div class="section-header">
                        <h2>Profile Settings</h2>
                    </div>
                    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
                        <div class="avatar" style="width:60px;height:60px;font-size:1.2rem;">
                            @GetInitials(customer?.Name ?? "ZA")
                        </div>
                        <div>
                            <div style="font-weight:600;">@(customer?.Name ?? "Zahra Ali")</div>
                            <div style="font-size:0.8rem;color:#999;">Member since Jan 2024</div>
                        </div>
                    </div>

                    <div style="display:grid;gap:1rem;">
                        <div>
                            <label style="display:block;font-size:0.78rem;color:#999;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:6px;">Full Name</label>
                            <input type="text" value="@(customer?.Name ?? "Zahra Ali")" style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e8e8e8;border-radius:12px;font-family:'DM Sans',sans-serif;font-size:0.95rem;outline:none;background:#fafafa;" />
                        </div>
                        <div>
                            <label style="display:block;font-size:0.78rem;color:#999;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:6px;">Email</label>
                            <input type="email" value="@(customer?.Email ?? "zahra@email.com")" style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e8e8e8;border-radius:12px;font-family:'DM Sans',sans-serif;font-size:0.95rem;outline:none;background:#fafafa;" />
                        </div>
                        <div>
                            <label style="display:block;font-size:0.78rem;color:#999;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:6px;">Phone</label>
                            <input type="tel" value="@(customer?.Phone ?? "+92 300 1234567")" style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e8e8e8;border-radius:12px;font-family:'DM Sans',sans-serif;font-size:0.95rem;outline:none;background:#fafafa;" />
                        </div>
                        <button class="order-btn" style="width:fit-content;">Save Changes</button>
                    </div>
                </div>
            }

           </main>
    </div>
</div>


@code{
    private string activeTab = "orders";
    private string orderFilter = "all";
    private Customer? customer;
    private List<OrderViewModel> orders = new();
    private List<FavoriteViewModel> favorites = new();
    private List<AddressViewModel> addresses = new();

    protected override async Task OnInitializedAsync()
    {
        customer = new Customer { Name = " Ali", Email = "Ali@email.com", Phone = "+92 311 2345678" };

        var serviceOrders = await OrderService.GetCustomerOrdersAsync(customer.Id);
        orders = serviceOrders?.Select(o => new OrderViewModel
        {
            Id = o.Id,
            RestaurantName = o.RestaurantName ?? "KFC Pakistan",
            RestaurantEmoji = o.RestaurantEmoji ?? "🍗",
            ItemsSummary = o.ItemsSummary ?? "Zinger Burger × 2, Fries × 1",
            TotalAmount = (int)o.TotalAmount,
            Status = o.Status ?? "Delivered",
            PlacedAt = o.PlacedAt
        }).ToList() ?? GetSampleOrders();



    }








}