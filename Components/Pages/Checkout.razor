@page "/checkout"
@rendermode InteractiveServer
@using BlazorApp5.Models
@using BlazorApp5.Services
@inject CartService CartService
@inject OrderService OrderService
@inject NavigationManager Navigation

<PageTitle>Checkout - FoodPanda</PageTitle>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body, .checkout-root {
        font-family: 'DM Sans', sans-serif;
        background: #fef6f0;
        min-height: 100vh;
        color: #1a1a1a;
    }

    .checkout-root {
        padding: 2rem 1rem;
    }

    .checkout-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    checkout-header h1 {
        font-family: 'Sora', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: #d4380d;
    }

    .checkout-grid {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 2rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    @@media (max-width: 900px) {
        .checkout-grid {
            grid-template-columns: 1fr;
        }
    }

    .section-card {
        background: #fff;
        border-radius: 18px;
        padding: 1.75rem;
        box-shadow: 0 2px 20px rgba(0,0,0,0.06);
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-family: 'Sora', sans-serif;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 1.25rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: #666;
            margin-bottom: 6px;
        }

        .form-group input, .form-group textarea {
            width: 100%;
            padding: 0.7rem 1rem;
            border: 1.5px solid #e8e8e8;
            border-radius: 12px;
        }

    .payment-options {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
    }

    .payment-option {
        border: 1.5px solid #e8e8e8;
        border-radius: 12px;
        padding: 0.75rem;
        cursor: pointer;
        text-align: center;
        background: #fafafa;
    }

</style>