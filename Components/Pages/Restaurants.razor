@page "/restaurants"
@rendermode InteractiveServer
@using BlazorApp5.Models
@using BlazorApp5.Services

<div class="rest-page">

    <div class="search-wrapper">
        <div class="search-bar-container">
            <input type="text"
                   class="search-input-field"
                   placeholder="Search restaurants or dishes..."
                   @bind="tempSearchText"
                   @onkeyup="HandleKeyUp" />

            <button class="search-action-btn" @onclick="ApplySearch">
                Search 🔍
            </button>
        </div>
    </div>

    <div class="filters-list">
        @foreach (var category in categories)
        {
            <button class="filter-tag @(selectedCategory == category ? "active" : "")"
                    @onclick="() => selectedCategory = category">
                @category
            </button>
        }
    </div>

    <div class="restaurant-grid">
        @if (FilteredRestaurants.Any())
        {
            @foreach (var res in FilteredRestaurants)
            {
                <a href="/menu/@res.Id" class="res-card">
                    <div class="res-emoji">@res.Emoji</div>
                    <div class="res-info">
                        <h3>@res.Name</h3>
                        <p>@res.Cuisine • ⭐ @res.Rating</p>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="no-data">
                <p>No results found for "@appliedSearchText"</p>
                <button @onclick="ResetFilters">Reset All</button>
            </div>
        }
    </div>
</div>

<style>
    /* Aapki image jaisa orange gradient background aur white search bar */
    .search-wrapper {
        background: linear-gradient(to right, #ff4b2b, #ff416c);
        padding: 50px 20px;
        display: flex;
        justify-content: center;
        border-radius: 15px;
        margin-bottom: 30px;
    }

    .search-bar-container {
        display: flex;
        width: 100%;
        max-width: 600px;
        background: white;
        border-radius: 50px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .search-input-field {
        flex: 1;
        border: none;
        padding: 15px 25px;
        outline: none;
        font-size: 1rem;
    }

    .search-action-btn {
        background: #d4380d;
        color: white;
        border: none;
        padding: 0 35px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
    }

        .search-action-btn:hover {
            background: #b83209;
        }

    /* Filters & Cards Styling */
    .filters-list {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        overflow-x: auto;
        padding: 10px 0;
    }

    .filter-tag {
        padding: 8px 20px;
        border-radius: 20px;
        border: 1px solid #ddd;
        background: white;
        cursor: pointer;
        white-space: nowrap;
    }

        .filter-tag.active {
            background: #d4380d;
            color: white;
            border-color: #d4380d;
        }

    .restaurant-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .res-card {
        text-decoration: none;
        color: black;
        background: white;
        border-radius: 15px;
        border: 1px solid #eee;
        overflow: hidden;
        transition: 0.3s;
    }

        .res-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .res-emoji {
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        background: #fffcf0;
    }

    .res-info {
        padding: 15px;
    }
</style>

@code {
    private string tempSearchText = "";     // Jo type ho raha hai
    private string appliedSearchText = "";  // Jo Search click karne par save ho
    private string selectedCategory = "All";

    private List<string> categories = new() { "All", "Fast Food", "Desi", "Pizza", "Healthy" };

    // Filtering Logic: Search aur Category dono ko ek saath check karega
    private List<Restaurant> FilteredRestaurants => allRestaurants
        .Where(r =>
            (selectedCategory == "All" || r.Cuisine == selectedCategory) &&
            (string.IsNullOrWhiteSpace(appliedSearchText) ||
             r.Name.Contains(appliedSearchText, StringComparison.OrdinalIgnoreCase))
        ).ToList();

    // Jab button click ho
    private void ApplySearch()
    {
        appliedSearchText = tempSearchText;
    }

    // Jab keyboard se Enter dabaya jaye
    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplySearch();
        }
    }

    private void ResetFilters()
    {
        tempSearchText = "";
        appliedSearchText = "";
        selectedCategory = "All";
    }

    private List<Restaurant> allRestaurants = new()
    {
        new() { Id=1, Name="KFC Pakistan", Cuisine="Fast Food", Emoji="🍗", Rating=4.5 },
        new() { Id=2, Name="Pizza Hut", Cuisine="Pizza", Emoji="🍕", Rating=4.3 },
        new() { Id=3, Name="Biryani Centre", Cuisine="Desi", Emoji="🍛", Rating=4.7 },
        new() { Id=4, Name="Subway", Cuisine="Healthy", Emoji="🥖", Rating=4.2 }
    };
}