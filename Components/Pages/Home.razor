@page "/"
@using BlazorApp5.Models
@using BlazorApp5.Services

<PageTitle>FoodPanda - Order Food Online</PageTitle>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }
    body {
        font-family: 'DM Sans', sans-serif;
        background: #fff;
    }

    .hero {
        background: linear-gradient(135deg, #d4380d 0%, #fa541c 60%, #fa8c16 100%);
        padding: 5rem 2rem 4rem;
        text-align: center;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .hero::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
            top: -200px;
            right: -100px;
        }
        .hero h1 {
            font-family: 'Sora', sans-serif;
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        .hero p {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-bottom: 2rem;
        }
    .search-bar {
        display: flex;
        max-width: 550px;
        margin: 0 auto;
        background: #fff;
        border-radius: 50px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    }
        .search-bar input {
            flex: 1;
            padding: 1rem 1.5rem;
            border: none;
            outline: none;
            font-size: 1rem;
            font-family: 'DM Sans', sans-serif;
            color: #333;
        }

        .search-bar button {
            padding: 1rem 1.75rem;
            background: #d4380d;
            color: #fff;
            border: none;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Sora', sans-serif;
            transition: background 0.2s;
        }
            .search-bar button:hover {
                background: #b83209;
            }

    .hero-stats {
        display: flex;
        justify-content: center;
        gap: 3rem;
        margin-top: 3rem;
    }

    .stat {
        text-align: center;
    }
    .stat-num {
        font-family: 'Sora', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
    }

    .stat-lbl {
        font-size: 0.85rem;
        opacity: 0.8;
        margin-top: 2px;
    }

    .section {
        padding: 4rem 2rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .section-title {
        font-family: 'Sora', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 0.5rem;
    }

    .section-sub {
        color: #999;
        font-size: 0.9rem;
        margin-bottom: 2rem;
    }

    .categories {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 1rem;
    }

    .category-card {
        background: #fff;
        border: 1.5px solid #f0f0f0;
        border-radius: 16px;
        padding: 1.25rem 0.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

        .category-card:hover {
            border-color: #d4380d;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(212,56,13,0.1);
        }
    .cat-emoji {
        font-size: 2rem;
        display: block;
        margin-bottom: 0.5rem;
    }

    .cat-name {
        font-size: 0.82rem;
        font-weight: 600;
        color: #333;
    }
    .restaurants-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }
    .restaurant-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        border: 1.5px solid #f0f0f0;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: block;
    }

        .restaurant-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.1);
            border-color: #ffd591;
        }
    .restaurant-img {
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        background: linear-gradient(135deg, #fff1e6, #ffe7cc);
    }

    .restaurant-info {
        padding: 1rem 1.25rem 1.25rem;
    }

    .restaurant-name {
        font-family: 'Sora', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
    }
    .restaurant-meta {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;
        font-size: 0.8rem;
        color: #999;
    }

        .restaurant-meta span {
            display: flex;
            align-items: center;
            gap: 3px;
        }
    .badge {
        display: inline-block;
        background: #fff1e6;
        color: #d4380d;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 50px;
        margin-top: 0.5rem;
    }

    .how-section {
        background: #fef6f0;
        padding: 4rem 2rem;
        text-align: center;
    }

    .steps {
        display: flex;
        justify-content: center;
        gap: 3rem;
        margin-top: 2.5rem;
        flex-wrap: wrap;
    }
    .step {
        max-width: 180px;
    }

    .step-icon {
        width: 70px;
        height: 70px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 1rem;
        box-shadow: 0 4px 15px rgba(212,56,13,0.15);
    }

    .step h3 {
        font-family: 'Sora', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 0.4rem;
    }

    .step p {
        font-size: 0.82rem;
        color: #999;
        line-height: 1.5;
    }