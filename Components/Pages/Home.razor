@page "/"
@using BlazorApp5.Models
@using BlazorApp5.Services

<PageTitle>FoodPanda - Order Food Online</PageTitle>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: #fff;
    }

    .hero {
        background: linear-gradient(135deg, #d4380d 0%, #fa541c 60%, #fa8c16 100%);
        padding: 5rem 2rem 4rem;
        text-align: center;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .hero::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
            top: -200px;
            right: -100px;
        }

        .hero h1 {
            font-family: 'Sora', sans-serif;
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        .hero p {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-bottom: 2rem;
        }

    .search-bar {
        display: flex;
        max-width: 550px;
        margin: 0 auto;
        background: #fff;
        border-radius: 50px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    }

        .search-bar input {
            flex: 1;
            padding: 1rem 1.5rem;
            border: none;
            outline: none;
            font-size: 1rem;
            font-family: 'DM Sans', sans-serif;
            color: #333;
        }

        .search-bar button {
            padding: 1rem 1.75rem;
            background: #d4380d;
            color: #fff;
            border: none;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Sora', sans-serif;
            transition: background 0.2s;
        }

            .search-bar button:hover {
                background: #b83209;
            }

    .hero-stats {
        display: flex;
        justify-content: center;
        gap: 3rem;
        margin-top: 3rem;
    }

    .stat {
        text-align: center;
    }

    .stat-num {
        font-family: 'Sora', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
    }

    .stat-lbl {
        font-size: 0.85rem;
        opacity: 0.8;
        margin-top: 2px;
    }

    /* Categories */
    .section {
        padding: 4rem 2rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .section-title {
        font-family: 'Sora', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 0.5rem;
    }

    .section-sub {
        color: #999;
        font-size: 0.9rem;
        margin-bottom: 2rem;
    }

    .categories {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 1rem;
    }

    .category-card {
        background: #fff;
        border: 1.5px solid #f0f0f0;
        border-radius: 16px;
        padding: 1.25rem 0.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

        .category-card:hover {
            border-color: #d4380d;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(212,56,13,0.1);
        }

    .cat-emoji {
        font-size: 2rem;
        display: block;
        margin-bottom: 0.5rem;
    }

    .cat-name {
        font-size: 0.82rem;
        font-weight: 600;
        color: #333;
    }

    /* Restaurant cards */
    .restaurants-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .restaurant-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        border: 1.5px solid #f0f0f0;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: block;
    }

        .restaurant-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.1);
            border-color: #ffd591;
        }

    .restaurant-img {
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        background: linear-gradient(135deg, #fff1e6, #ffe7cc);
    }

    .restaurant-info {
        padding: 1rem 1.25rem 1.25rem;
    }

    .restaurant-name {
        font-family: 'Sora', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .restaurant-meta {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;
        font-size: 0.8rem;
        color: #999;
    }

        .restaurant-meta span {
            display: flex;
            align-items: center;
            gap: 3px;
        }

    .badge {
        display: inline-block;
        background: #fff1e6;
        color: #d4380d;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 50px;
        margin-top: 0.5rem;
    }

    /* How it works */
    .how-section {
        background: #fef6f0;
        padding: 4rem 2rem;
        text-align: center;
    }

    .steps {
        display: flex;
        justify-content: center;
        gap: 3rem;
        margin-top: 2.5rem;
        flex-wrap: wrap;
    }

    .step {
        max-width: 180px;
    }

    .step-icon {
        width: 70px;
        height: 70px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 1rem;
        box-shadow: 0 4px 15px rgba(212,56,13,0.15);
    }

    .step h3 {
        font-family: 'Sora', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 0.4rem;
    }

    .step p {
        font-size: 0.82rem;
        color: #999;
        line-height: 1.5;
    }

    /* CTA */
    .cta-section {
        background: linear-gradient(135deg, #1a1a1a, #333);
        color: #fff;
        padding: 4rem 2rem;
        text-align: center;
    }

        .cta-section h2 {
            font-family: 'Sora', sans-serif;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .cta-section p {
            color: #aaa;
            margin-bottom: 2rem;
        }

    .cta-btn {
        display: inline-block;
        padding: 1rem 2.5rem;
        background: #d4380d;
        color: #fff;
        border-radius: 50px;
        font-family: 'Sora', sans-serif;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        transition: all 0.2s;
    }

        .cta-btn:hover {
            background: #fa541c;
            transform: translateY(-2px);
        }
</style>

<!-- Hero -->
<div class="hero">
    <h1>🐼 Hungry? <br />We've Got You!</h1>
    <p>Order from the best restaurants near you. Fast delivery, great taste.</p>
    <div class="search-bar">
        <input type="text" @bind="searchQuery" placeholder="Search restaurants or dishes..." />
        <button @onclick="Search">Search 🔍</button>
    </div>
    <div class="hero-stats">
        <div class="stat"><div class="stat-num">500+</div><div class="stat-lbl">Restaurants</div></div>
        <div class="stat"><div class="stat-num">30min</div><div class="stat-lbl">Avg Delivery</div></div>
        <div class="stat"><div class="stat-num">50K+</div><div class="stat-lbl">Happy Customers</div></div>
    </div>
</div>

<!-- Categories -->
<div class="section">
    <div class="section-title">What are you craving?</div>
    <div class="section-sub">Pick a category and explore</div>
    <div class="categories">
        @foreach (var cat in categories)
        {
            <a href="/restaurants" class="category-card">
                <span class="cat-emoji">@cat.Emoji</span>
                <div class="cat-name">@cat.Name</div>
            </a>
        }
    </div>
</div>

<!-- Popular Restaurants -->
<div class="section" style="padding-top:0;">
    <div class="section-title">Popular Near You 🔥</div>
    <div class="section-sub">Top rated restaurants ordering right now</div>
    <div class="restaurants-grid">
        @foreach (var r in popularRestaurants)
        {
            <a href="/restaurants" class="restaurant-card">
                <div class="restaurant-img">@r.Emoji</div>
                <div class="restaurant-info">
                    <div class="restaurant-name">@r.Name</div>
                    <div class="restaurant-meta">
                        <span>⭐ @r.Rating</span>
                        <span>🕐 @r.DeliveryTime min</span>
                        <span>🛵 Rs. @r.DeliveryFee</span>
                    </div>
                    <span class="badge">@r.Tag</span>
                </div>
            </a>
        }
    </div>
</div>

<!-- How it works -->
<div class="how-section">
    <div style="font-family:'Sora',sans-serif;font-size:1.6rem;font-weight:700;color:#1a1a1a;">How It Works</div>
    <div style="color:#999;font-size:0.9rem;margin-top:0.4rem;">Order in 3 simple steps</div>
    <div class="steps">
        <div class="step">
            <div class="step-icon">📍</div>
            <h3>Choose Location</h3>
            <p>Enter your delivery address and we find restaurants near you</p>
        </div>
        <div class="step">
            <div class="step-icon">🍔</div>
            <h3>Pick Your Food</h3>
            <p>Browse menus, add items to cart and customize your order</p>
        </div>
        <div class="step">
            <div class="step-icon">🛵</div>
            <h3>Fast Delivery</h3>
            <p>Track your rider in real time and enjoy your meal</p>
        </div>
    </div>
</div>

<!-- CTA -->
<div class="cta-section">
    <h2>Ready to Order? 🍕</h2>
    <p>Join 50,000+ customers enjoying delicious food delivered fast</p>
    <a href="/register" class="cta-btn">Get Started Free →</a>
</div>

@code {
    private string searchQuery = "";

    private void Search()
    {
        // Navigate to restaurants with search query
    }

    private List<CategoryItem> categories = new()
    {
        new("🍔", "Burgers"), new("🍕", "Pizza"), new("🍛", "Biryani"),
        new("🍗", "Chicken"), new("🥖", "Sandwiches"), new("🍜", "Noodles"),
        new("🧁", "Desserts"), new("🥗", "Healthy"), new("🍣", "Sushi"),
        new("☕", "Drinks"), new("🌮", "Wraps"), new("🍩", "Bakery")
    };

    private List<RestaurantPreview> popularRestaurants = new()
    {
        new("KFC Pakistan", "🍗", 4.5, 25, 80, "🔥 Popular"),
        new("Pizza Hut", "🍕", 4.3, 35, 100, "⚡ Fast Delivery"),
        new("Biryani Centre", "🍛", 4.7, 40, 60, "⭐ Top Rated"),
        new("McDonald's", "🍔", 4.4, 20, 80, "🔥 Popular"),
        new("Subway", "🥖", 4.1, 30, 70, "🥗 Healthy"),
        new("Hardee's", "🍔", 4.2, 28, 90, "⚡ Fast Delivery"),
    };

    record CategoryItem(string Emoji, string Name);
    record RestaurantPreview(string Name, string Emoji, double Rating, int DeliveryTime, int DeliveryFee, string Tag);
}
